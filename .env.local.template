# FundLens Audit — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# ── Anthropic ─────────────────────────────────────────────────────────────
# BYOK: there is NO server-side Anthropic key. Each user supplies their own key
# in the app UI (held in their browser tab only, sent per-request, never stored).
# Nothing to set here.

# ── Neon (Postgres) ───────────────────────────────────────────────────────
# Create project "fundlens-audit" at neon.tech. Use the pooled connection string.
DATABASE_URL=

# ── Upstash Redis ─────────────────────────────────────────────────────────
# Create database "fundlens-audit" at console.upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Vercel Blob ───────────────────────────────────────────────────────────
# Set automatically by Vercel after running: vercel link && vercel storage create
# For local dev: copy the token from Vercel dashboard → Storage → your blob store.
BLOB_READ_WRITE_TOKEN=

# ── CloudConvert (DOCX → PDF) ─────────────────────────────────────────────
# Create account at cloudconvert.com. Use a "conversion" job API key (not sandbox).
CLOUDCONVERT_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=FundLens Audit
NEXT_PUBLIC_APP_VERSION=1.0.0
